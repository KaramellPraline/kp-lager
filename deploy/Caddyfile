{$LAGER_HOST} {
	tls internal
	encode gzip
	request_body {
		max_size 40MB
	}
	reverse_proxy app:8000
}

# HTTP: Root-Zertifikat fürs Handy, sonst Umleitung auf HTTPS
http://{$LAGER_HOST} {
	handle /ca.crt {
		root * /data/caddy/pki/authorities/local
		rewrite * /root.crt
		header Content-Type application/x-x509-ca-cert
		file_server
	}
	handle {
		redir https://{host}{uri}
	}
}
