[Unit]
Description=Sortiersystem (Lager-Inventar)
After=network.target

[Service]
User=lager
Group=lager
WorkingDirectory=/opt/sortiersystem
EnvironmentFile=/etc/sortiersystem.env
ExecStart=/opt/sortiersystem/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --proxy-headers
Restart=on-failure
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/sortiersystem

[Install]
WantedBy=multi-user.target
