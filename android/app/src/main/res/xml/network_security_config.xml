<?xml version="1.0" encoding="utf-8"?>
<!-- Eigene CA des Lagers (unter Android als Nutzer-Zertifikat installiert) zulassen;
     http nur für Adressen im eigenen Netz (z. B. http://192.168.x.x:8000 beim Testen). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
