{
  "name": "KP Lager",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "features": {},
  "postCreateCommand": "pip install uv && uv sync --group dev --group mcp",
  "forwardPorts": [8000],
  "portsAttributes": { "8000": { "label": "KP Lager" } },
  "containerEnv": {
    "LAGER_DATA_DIR": "/tmp/lager-data",
    "LAGER_AUTO_BACKUP": "0",
    "LAGER_D30": "0"
  },
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "charliermarsh.ruff"]
    }
  }
}
